{
    "name": "Focus-Filter-Extension",
    "version": "1.0",
    "manifest_version": 3,
    "description": "Filter out distracting content and keep you focused",
    "permissions": ["activeTab"],
    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}