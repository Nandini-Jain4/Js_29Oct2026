{
  "manifest_version": 3,
  "name": "AdShield",
  "version": "1.0",
  "description": "My first YouTube Ad Blocker",

  "host_permissions": [
    "https://www.youtube.com/*"
  ],

  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}