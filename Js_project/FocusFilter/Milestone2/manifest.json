{
    "name": "Focus-Filter-Extension",
    "version": "1.1",
    "manifest_version": 3,
    "description": "Filter out distracting content and keep you focused",

    "permissions": [
        "activeTab",
        "storage"
    ],

    "action": {
        "default_popup": "popup.html"
    },

    "content_scripts": [
        {
            "matches": ["<all_urls>"],
            "js": ["content.js"]
        }
    ]
}